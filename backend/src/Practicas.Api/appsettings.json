{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Practicas": "Data Source=App_Data/practicas.db"
  },
  "Almacenamiento": {
    "RutaHojasDeVida": "App_Data/hojas-de-vida",
    "TamanoMaximoBytes": 5242880
  },
  "Autenticacion": {
    "Emisor": "Practicas.Api",
    "Audiencia": "Practicas.Web",
    "ClaveFirma": "",
    "MinutosExpiracion": 60,
    "Analista": {
      "Usuario": "",
      "ContrasenaHash": "",
      "NombreVisible": "Analista de selección"
    }
  },
  "LimitesSolicitudes": {
    "IntentosLogin": 5,
    "MinutosVentanaLogin": 5,
    "RegistrosPorVentana": 10,
    "MinutosVentanaRegistro": 60
  },
  "Cors": {
    "OrigenesPermitidos": [ "http://localhost:4200" ]
  }
}
